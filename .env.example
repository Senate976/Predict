# Copie ce fichier en `.env` et remplis les valeurs.
# Project Settings > Data API dans le dashboard Supabase.
# Le préfixe EXPO_PUBLIC_ est nécessaire pour que la variable soit lisible côté client.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique de l'app, vers laquelle pointe le lien d'invitation envoyé
# par SMS depuis le Cercle. Un lien « predict:// » ne mènerait nulle part chez
# quelqu'un qui n'a pas encore installé l'app — c'est-à-dire précisément la
# personne qu'on invite.
EXPO_PUBLIC_INVITE_URL=https://ton-domaine.vercel.app
